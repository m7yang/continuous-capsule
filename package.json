    "src",
    "README.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "generate:profile": "node scripts/generate-profile.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "packageManager": "pnpm@12.3.4"
}

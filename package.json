{
  "name": "continuous-capsule",
  "version": "0.3.0",
  "description": "Dependency-free geometry for SwiftUI-style continuous capsules and rounded rectangles.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m7yang/continuous-capsule.git"
  },
  "license": "MIT",
  "type": "module",
